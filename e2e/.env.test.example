# FDF E2E Test Environment Variables
# Copy this file to e2e/.env.test — NEVER commit e2e/.env.test
#
# Prerequisites: run `npm run e2e:setup` in FDF_Backend first.

BASE_URL=http://localhost:4200
API_URL=http://localhost:3501

# Shared test password (matches DEFAULT_PASSWORD in FDF_Backend/.env.e2e)
E2E_PASSWORD=E2eTest!2026

# Test usernames (seeded by FDF_Backend/scripts/e2e-seed.js)
E2E_GLOBAL_ADMIN_USERNAME=e2e_global_admin
E2E_REG_ADMIN_USERNAME=e2e_reg_admin
E2E_COMP_ADMIN_USERNAME=e2e_comp_admin
E2E_JUDGE_ADMIN_USERNAME=e2e_judge_admin
E2E_JUDGE_USERNAME=e2e_judge
E2E_VIEWER_USERNAME=e2e_viewer

# Passwords default to E2E_PASSWORD when unset
# E2E_GLOBAL_ADMIN_PASSWORD=
# E2E_REG_ADMIN_PASSWORD=
# E2E_COMP_ADMIN_PASSWORD=
# E2E_JUDGE_ADMIN_PASSWORD=
# E2E_JUDGE_PASSWORD=
# E2E_VIEWER_PASSWORD=

# ─── FDF Portal (Phase 3) ──────────────────────────────────────────────────
PORTAL_BASE_URL=http://localhost:4201

# Phase 3 Director E2E accounts (seeded by e2e-seed.js)
DIRECTOR_A_EMAIL=director.a@e2e.test
DIRECTOR_B_EMAIL=director.b@e2e.test
